{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vocab policy routing registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "alwaysRequired",
    "fallbackDocuments",
    "applicationPathPrefixes",
    "broadSharedPaths",
    "tasks",
    "rules",
    "knownConflicts"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "alwaysRequired": {"$ref": "#/$defs/documents"},
    "fallbackDocuments": {"$ref": "#/$defs/documents"},
    "applicationPathPrefixes": {"$ref": "#/$defs/strings"},
    "broadSharedPaths": {"$ref": "#/$defs/strings"},
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    },
    "knownConflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documents", "message"],
        "properties": {
          "documents": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "documents": {"$ref": "#/$defs/strings"},
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "documents"],
      "properties": {
        "when": {"type": "string", "minLength": 1},
        "documents": {"$ref": "#/$defs/documents"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "type"],
      "properties": {
        "to": {"type": "string", "minLength": 1},
        "type": {"enum": ["requires", "recommends", "historicalReference"]}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "recommended", "conditional", "edges", "audit", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "tasks": {"$ref": "#/$defs/strings"},
        "pathPrefixes": {"$ref": "#/$defs/strings"},
        "pathSuffixes": {"$ref": "#/$defs/strings"},
        "required": {"$ref": "#/$defs/documents"},
        "changeRequired": {"$ref": "#/$defs/documents"},
        "recommended": {"$ref": "#/$defs/documents"},
        "conditional": {
          "type": "array",
          "items": {"$ref": "#/$defs/condition"}
        },
        "edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/edge"}
        },
        "audit": {"enum": ["required", "none"]},
        "evidence": {"enum": ["durable", "transient", "none"]}
      }
    }
  }
}
